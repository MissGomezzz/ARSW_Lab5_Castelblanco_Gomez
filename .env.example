# true  -> uses the in-memory apimock service (no backend needed)
# false -> uses the apiclient service against the real REST API (Labs 3 and 4)
VITE_USE_MOCK=true

# Leave empty to call the backend through the Vite dev proxy (same origin, no CORS issues)
VITE_API_BASE_URL=

# Backend the Vite dev proxy forwards /api and /auth to
VITE_BACKEND_URL=http://localhost:8080
